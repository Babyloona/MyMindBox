# Скопируйте этот файл в .env и впишите свои значения.
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# LLM: определение намерения и проверка совпадения
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Запасной провайдер, если OpenAI недоступен (поставьте LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Эмбеддинги: local (бесплатно, на вашем компьютере) или openai
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Наблюдаемость (необязательно): ключи из cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Служебное
APP_ENV=dev
HEALTH_PORT=8080
# Сколько кандидатов проверяет LLM (1 или 3, см. раздел 9 ноутбука)
VERIFY_TOP_K=3
# Сколько заметок достаётся на запрос «покажи все»
SEARCH_ALL_TOP_K=10